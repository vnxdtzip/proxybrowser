{
  "name": "unleashed-browser",
  "productName": "Unleashed Browser",
  "version": "0.1.0",
  "private": true,
  "description": "Navegador Electron minimo com todo o trafego forcado por um proxy HTTPS (teste de red team).",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "encrypt-config": "node build/encrypt-config.js",
    "adblock": "node build/gen-adblock.js",
    "package": "node build/package-clean.js",
    "build": "npm run encrypt-config && npm run package",
    "server": "node server/proxy-server.js"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^45.5.0"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-electron": "^2.20.3"
  }
}
